{
  "name": "frontend",
  "version": "1.2.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:staging": "vite --host 0.0.0.0 --mode staging",
    "dev:prod": "vite --host 0.0.0.0 --mode production",
    "dev:msw": "vite --host 0.0.0.0 --mode msw",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "preview:staging": "vite preview --mode staging",
    "preview:prod": "vite preview --mode production",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --cache --cache-strategy content --cache-location .eslintcache --fix",
    "lint:check": "eslint . --cache --cache-strategy content --cache-location .eslintcache --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api": "openapi-typescript https://raw.githubusercontent.com/traPtitech/rucQ/main/openapi.yaml -o src/api/schema.d.ts && pnpm format"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "v24.22.0"
  },
  "dependencies": {
    "@fontsource-variable/m-plus-2": "5.3.1",
    "@fontsource-variable/m-plus-code-latin": "5.3.0",
    "@fontsource-variable/reddit-sans": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@mdi/font": "7.4.47",
    "@tanstack/query-async-storage-persister": "5.104.5",
    "@tanstack/query-persist-client-core": "5.104.5",
    "@tanstack/vue-query": "5.104.5",
    "@tanstack/vue-query-devtools": "6.3.5",
    "@yeger/vue-masonry-wall": "6.1.4",
    "dompurify": "3.4.17",
    "localforage": "1.10.0",
    "markdown-it": "14.3.3",
    "msw": "2.15.0",
    "openapi-fetch": "0.17.0",
    "openapi-msw": "2.1.0",
    "pinia": "3.0.4",
    "vite-plugin-vuetify": "2.1.3",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vuetify": "3.13.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node24": "24.0.5",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@vite-pwa/assets-generator": "1.0.4",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-vue": "10.11.1",
    "npm-run-all2": "9.0.4",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "rollup-plugin-visualizer": "7.1.1",
    "sass": "1.106.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-vue-devtools": "8.2.1",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
